# ===== 复制本文件为 .env 并填写真实值 =====
# 不要提交 .env 到 git，也不要粘贴到对话里

# API Key（阿里云百炼 MaaS）
DASHSCOPE_API_KEY=sk-在这里填入你的key

# 模型名
MODEL=qwen3.8-max

# OpenAI 兼容端点 base_url（百炼 MaaS 专有端点）
BASE_URL=https://llm-jv90b8kcf9gvk89g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 目标城市（决定读取 data/docs/{CITY}/ 下的语料，换城市改这里 + 加一份语料）
CITY=上海

# 回答模式：brief / standard / report（可被命令行 --mode 或问题自然语言覆盖）
REPLY_MODE=standard

# ===== 可观测性（选填，不填走默认）=====
# 日志级别：DEBUG / INFO / WARNING / ERROR（结构化 JSON 日志写入 data/logs/app.log）
LOG_LEVEL=INFO
# 日志目录（默认项目内 data/logs，已被 .gitignore 忽略）
# LOG_DIR=./data/logs

# token 单价（每 1K token），用于把模型用量折算成本并落库。不填/填 0 → 成本记为空（不臆造金额）。
# 具体价格以你所用模型（如百炼 qwen）官方计费为准。
PRICE_IN_PER_1K=0
PRICE_OUT_PER_1K=0

# ===== 安全与防护（P1，选填）=====
# 单次问题长度上限（字符），防误贴/超长烧 token；<=0 不限。与前端 ChatView 的 MAX_INPUT 保持同步。
MAX_INPUT_CHARS=2000
# 模型调用重试次数与固定退避间隔（秒）；弱网/限流可适当调高。
MODEL_MAX_RETRIES=3
MODEL_RETRY_DELAY=1.0

# 访问令牌（每人一个）：user_id:token 逗号分隔。token 是访问凭证，user_id 用于数据隔离。
# 留空→鉴权关闭（本地自用）；配置后所有 /api 与推理端点需携令牌，前端首次会弹令牌门。
# 用高强度随机串作 token（例如 openssl rand -hex 16），不要直接用可猜的用户名。
# AGENT_TOKENS=lirui:8f3a…c1d2,朋友:x9y8…
